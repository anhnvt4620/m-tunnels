FROM golang:1.25 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/m-tunnel-gateway ./cmd/gateway
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/m-tunnel-hashpw ./cmd/hashpw

FROM alpine:3.20
WORKDIR /app
RUN mkdir -p /app/configs /app/logs /app/data && \
    apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/m-tunnel-gateway /app/m-tunnel-gateway
COPY --from=builder /out/m-tunnel-hashpw /app/m-tunnel-hashpw
EXPOSE 8080 8443 12600-12799
VOLUME ["/app/data", "/app/configs", "/app/logs"]
ENTRYPOINT ["/app/m-tunnel-gateway"]
CMD ["-config", "/app/configs/gateway.yaml"]
